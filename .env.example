ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/creator_platform

# Fernet key for encrypting sensitive columns (e.g. social_accounts.access_token).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Add API keys / secrets below
# OPENAI_API_KEY=
GEMINI_API_KEY=

# Meta app credentials for "Instagram API with Instagram Login" (Business/Creator accounts)
META_APP_ID=
META_APP_SECRET=
# Must exactly match the OAuth redirect URI registered in the Meta app's
# "Instagram business login" API setup.
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback
